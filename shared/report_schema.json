{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Validator Build Report",
  "type": "object",
  "required": ["generated_at", "assets"],
  "properties": {
    "generated_at": {"type": "string"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_name", "status", "findings"],
        "properties": {
          "object_name": {"type": "string"},
          "status": {"enum": ["passed", "failed"]},
          "findings": {"type": "array"}
        }
      }
    }
  }
}
