{
  "name": "ImportValidatorTests",
  "syncRules": [
    { "pattern": "../shared/*.json", "use": "text" },
    { "pattern": "*.lua", "use": "moduleScript" }
  ],
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "ImportValidator": { "$path": "src" },
      "ImportValidatorTests": { "$path": "tests" }
    },
    "ReplicatedStorage": {
      "AssetValidatorShared": { "$path": "../shared" },
      "Packages": { "$path": "Packages" }
    }
  }
}
