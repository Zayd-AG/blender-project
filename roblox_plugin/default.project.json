{
  "name": "ImportValidator",
  "syncRules": [
    {
      "pattern": "../shared/*.json",
      "use": "text"
    }
  ],
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "ImportValidator": {
        "$path": "src"
      },
      "ImportValidatorTests": {
        "$path": "tests"
      }
    },
    "ReplicatedStorage": {
      "AssetValidatorShared": {
        "$path": "../shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    }
  }
}
